      <genFeatures notify="false" createChild="false" propertySortChoices="true" ecoreFeature="ecore:EReference petri.ecore#//ArcPondereSortant/destination"/>
    </genClasses>
    <genClasses ecoreClass="petri.ecore#//ArcLectureSeule"/>
    <genClasses ecoreClass="petri.ecore#//Temps">
