      <genFeatures notify="false" createChild="false" propertySortChoices="true" ecoreFeature="ecore:EReference petri.ecore#//ArcPondereEntrant/destination"/>
    </genClasses>
    <genClasses ecoreClass="petri.ecore#//ArcPondereSortant">
