<?xml version="1.0" encoding="ASCII"?>
<petri:ReseauPetri xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:petri="http://petri">
  <composants xsi:type="petri:Place" jetons="1" nom="test_idle"/>
  <composants xsi:type="petri:Place" nom="test_started"/>
  <composants xsi:type="petri:Place" nom="test_running"/>
  <composants xsi:type="petri:Place" nom="test_ended"/>
  <composants xsi:type="petri:Transition" nom="test_start"/>
  <composants xsi:type="petri:Transition" nom="test_end"/>
  <composants xsi:type="petri:ArcPondereEntrant" ponderation="1" source="//@composants.0"/>
  <composants xsi:type="petri:ArcPondereSortant" ponderation="1" destination="//@composants.1"/>
  <composants xsi:type="petri:ArcPondereSortant" ponderation="1" destination="//@composants.2"/>
  <composants xsi:type="petri:ArcPondereEntrant" ponderation="1" source="//@composants.2"/>
  <composants xsi:type="petri:ArcPondereSortant" ponderation="1" destination="//@composants.3"/>
</petri:ReseauPetri>
