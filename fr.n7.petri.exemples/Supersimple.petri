<?xml version="1.0" encoding="ASCII"?>
<petri:ReseauPetri xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:petri="http://petri" nom="test">
  <composants xsi:type="petri:Place" jetons="1" nom="test_idle"/>
