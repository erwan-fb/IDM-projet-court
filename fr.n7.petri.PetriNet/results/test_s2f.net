pl Process1_idle (1)
pl Process1_started (0)
pl Process1_running (0)
pl Process1_ended (0)
pl Process2_idle (1)
pl Process2_started (0)
pl Process2_running (0)
pl Process2_ended (0)
		
tr Process1_start Process1_idle -> Process1_started Process1_running 
tr Process1_end Process1_running -> Process1_ended 
