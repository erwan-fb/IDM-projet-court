[comment encoding = UTF-8 /]
[module verifPetri('http://simplepdl')]


[template public generateSeltVerifPetri(aProcess : Process)]
[comment @main/]
[file (aProcess.name + '.ltl', false, 'UTF-8')]
# une activité est toujours soit non commencée ou commencée
# ie jamais il existe i et s
# ie toujours ((-i) et s) ou (i et (-s))
	
[for (wd : simplePDL::WorkDefinition | getWorkDefinition(aProcess))]
[started(wd) + ';'/]
[/for]

# une activité est toujours soit commencée soit running soit finie (Etat unique)
# ie jamais il existe (i et r) ou (i et e) ou (r et e)
# ie toujours (i et (-r) et (-e)) ou ((-i) et r et (-e)) et ((-i) et (-r) et e)
	
[for (wd : simplePDL::WorkDefinition | getWorkDefinition(aProcess))]
[uniqueEtat(wd) + ';'/]
[/for]

# une activité commencée est toujours commencée
# ie toujours (s => toujours s)
	
[for (wd : simplePDL::WorkDefinition | getWorkDefinition(aProcess))]
[pasRetourS(wd) + ';'/]
[/for]

# ie toujours (r => toujours (r \/ e))
[for (wd : simplePDL::WorkDefinition | getWorkDefinition(aProcess))]
[pasRetourR(wd) + ';'/]
[/for]

# une activité fini est toujours fini
# ie toujours (s => toujours s)
	
[for (wd : simplePDL::WorkDefinition | getWorkDefinition(aProcess))]
[pasRetourE(wd) + ';'/]
[/for]

# une activité terminé a commencé un jour
# ie toujours (((un jour i) => (un jour e)) \/ (- <> e))
	
[for (wd : simplePDL::WorkDefinition | getWorkDefinition(aProcess))]
[commencerUnJour(wd) + ';'/]
[/for]

# initialement aucune tache n'a commencé
# ie un jour ( (i /\ ... /\ i) /\ (-e /\ ... /\ -e) /\ (-s /\ ... /\ -s) /\ (-r /\ ... /\ -r) /\ (res /\ ... /\ res))
[allNonCommencer(aProcess) + ';'/]

# total ressource constant

[/file]
[/template]

[query public getWorkDefinition(p : simplePDL::Process) : OrderedSet(simplePDL::WorkDefinition) =
	p.processElements
		->select(e | e.oclIsTypeOf(simplePDL::WorkDefinition))
		->collect(e | e.oclAsType(simplePDL::WorkDefinition))
		->asOrderedSet()
/]

[query public getTransitions(r : petri::ReseauPetri) : OrderedSet(petri::Transition) =
	r.composants
		->select(e | e.oclIsTypeOf(petri::Transition))
		->collect(e | e.oclAsType(petri::Transition))
		->asOrderedSet()
/]

[query public getRessource(p : simplePDL::Process) : OrderedSet(simplePDL::Ressource) =
	p.processElements
		->select(e | e.oclIsTypeOf(simplePDL::Ressource))
		->collect(e | e.oclAsType(simplePDL::Ressource))
		->asOrderedSet()
/]

[query public getNameIdle(wd : simplePDL::WorkDefinition) : String =
	wd.name  + '_idle'
/]
[query public getNameStarted(wd : simplePDL::WorkDefinition) : String =
	wd.name  + '_started'
/]
[query public getNameRuning(wd : simplePDL::WorkDefinition) : String =
	wd.name  + '_running'
/]
[query public getNameEnded(wd : simplePDL::WorkDefinition) : String =
	wd.name  + '_ended'
/]
[query public getNameRessource(r : simplePDL::Ressource) : String =
	r.name
/]
[query public getQuantityRessourceStr(r : simplePDL::Ressource) : String =
	r.quantityAvailable.toString()
/]


[query public started(wd : simplePDL::WorkDefinition) : String =
	'- <> (' + getNameIdle(wd) + ' /\\ ' + getNameStarted(wd) + ')'
/]
[query public uniqueEtat(wd : simplePDL::WorkDefinition) : String =
	'- <> ((' + getNameIdle(wd) + ' /\\ ' + getNameRuning(wd) + ') ' +
	 ' \\/ (' + getNameIdle(wd) + ' /\\ ' + getNameEnded(wd) + ') ' +
	 ' \\/ (' + getNameEnded(wd) + ' /\\ ' + getNameRuning(wd) + '))'
/]
[query public pasRetourR(wd : simplePDL::WorkDefinition) : String =
	'[] (' + getNameRuning(wd) + ' => [] ('
	 + getNameEnded(wd) + ' \\/ ' + getNameRuning(wd) + '))'
/]
[query public pasRetourS(wd : simplePDL::WorkDefinition) : String =
	'[] (' + getNameStarted(wd) + ' => [] ' + getNameStarted(wd) + ') '
/]
[query public pasRetourE(wd : simplePDL::WorkDefinition) : String =
	'[] (' + getNameEnded(wd) + ' => [] ' + getNameEnded(wd) + ') '
/]

[query public commencerUnJour(wd : simplePDL::WorkDefinition) : String =
	'[] (((<> ' + getNameIdle(wd) + ') => (<> ' + getNameEnded(wd) +
	')) \\/ (- <> '  + getNameEnded(wd) + ')) '
/]
[query public allNonCommencer(p : simplePDL::Process) : String =
	if getRessource(p)->notEmpty() then
		'<> ((' + getWorkDefinition(p)->collect(e| getNameIdle(e))->sep(' /\\ ') + ') \n\t'
		+ '/\\ ( ' + getWorkDefinition(p)->collect(e| '(- '+getNameStarted(e)+')')->sep(' /\\ ') + ') \n\t'
		+ '/\\ ( ' + getWorkDefinition(p)->collect(e| '(- '+getNameRuning(e)+')')->sep(' /\\ ') + ') \n\t'
		+ '/\\ ( ' + getWorkDefinition(p)->collect(e| '(- '+getNameEnded(e)+')')->sep(' /\\ ') + ') \n\t'
		+ '/\\ ( ' + getRessource(p)->collect(r| '( '+getNameRessource(r)+' = '+getQuantityRessourceStr(r)+' )')->sep(' /\\ ') + ')'
		+ ')'
	else
		'<> ((' + getWorkDefinition(p)->collect(e| getNameIdle(e))->sep(' /\\ ') + ') \n\t'
		+ '/\\ ( ' + getWorkDefinition(p)->collect(e| '(- '+getNameStarted(e)+')')->sep(' /\\ ') + ') \n\t'
		+ '/\\ ( ' + getWorkDefinition(p)->collect(e| '(- '+getNameRuning(e)+')')->sep(' /\\ ') + ') \n\t'
		+ '/\\ ( ' + getWorkDefinition(p)->collect(e| '(- '+getNameEnded(e)+')')->sep(' /\\ ') + ')'
		+ ')'
	endif
/]